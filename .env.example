# Salesforce Connected App consumer key (JWT issuer)
SF_CONSUMER_KEY=

# Salesforce username approved for the Connected App
SF_USERNAME=

# Use https://test.salesforce.com for a sandbox
SF_LOGIN_URL=https://login.salesforce.com
# Alternatively omit SF_LOGIN_URL and set SF_SANDBOX=true
SF_SANDBOX=false

# Generic URL for the specific org that owns the External Client App.
# This is the fourth JWTAuthenticate argument in current QForce examples.
SF_HOME_URL=https://your-domain.my.salesforce.com

# PEM private key whose matching certificate is uploaded to the Connected App
SF_PRIVATE_KEY_PATH=cert/server.key
